{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./worker/index.ts",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "EMAIL_FROM_ADDRESS": "mtgdisplaycr@gmail.com",
    "EMAIL_FROM_NAME": "MTG Display CR",
    "EMAIL_REPLY_TO": "mtgdisplaycr@gmail.com"
  }
}
